@baseUrl = http://localhost:4000/api/v1/auth

### Register (run once or change the email before repeating)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "manual.user@agile-tool.test",
  "name": "Manual User",
  "password": "ManualDev123!"
}

### Login with the seeded admin (run npm run seed first)
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "admin@agile-tool.test",
  "password": "AdminDev123!"
}

### Get the authenticated user
GET {{baseUrl}}/me
Authorization: Bearer {{login.response.body.token}}
